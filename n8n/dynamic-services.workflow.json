{
  "name": "LD LATTE - Dynamic Telegram Menu (Supabase)",
  "nodes": [
    {
      "id": "telegram-trigger",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "position": [
        140,
        260
      ],
      "parameters": {
        "updates": [
          "message",
          "callback_query"
        ],
        "additionalFields": {}
      },
      "webhookId": "4445d9c5-ae36-493e-aa77-075d3c949816"
    },
    {
      "id": "normalize-update",
      "name": "Normalize update",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        390,
        260
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const u = $input.first().json;\nconst cb = u.callback_query;\nif (cb) {\n  return [{ json: {\n    kind: 'callback',\n    chatId: cb.message?.chat?.id,\n    callbackId: cb.id,\n    messageId: cb.message?.message_id ?? null,\n    serviceId: /^service:\\d{1,18}$/.test(cb.data || '') ? Number(cb.data.slice(8)) : null,\n    isMenuReturn: cb.data === 'menu'\n  }}];\n}\nconst msg = u.message;\nreturn [{ json: {\n  kind: (msg?.text || '').trim().split(/\\s+/)[0].split('@')[0] === '/start' ? 'start' : 'help',\n  chatId: msg?.chat?.id,\n  callbackId: null,\n  messageId: null,\n  serviceId: null,\n  isMenuReturn: false\n}}];"
      }
    },
    {
      "id": "get-services-supabase-",
      "name": "Get services (Supabase)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        650,
        260
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL + '/rest/v1/services?select=id,name,active&order=id.asc' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_ANON_KEY }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "alwaysOutputData": true
    },
    {
      "id": "compose-reply",
      "name": "Compose reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        940,
        260
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const ctx = $('Normalize update').first().json;\nconst all = $input.all().map(x => x.json).filter(x => x && x.id != null);\nconst services = all.flatMap(x => Array.isArray(x) ? x : [x])\n  .map(x => ({ id: Number(x.id), name: String(x.name || ''), active: x.active === true }));\nconst active = services.filter(x => x.active);\nlet text = '';\nlet keyboard = null;\nif (ctx.kind === 'start' || (ctx.kind === 'callback' && ctx.isMenuReturn)) {\n  text = active.length\n    ? '🛍 Меню услуг\\n\\nВыберите услугу — бот подтвердит выбор.\\nСписок обновляется из базы данных.'\n    : 'Сейчас нет доступных услуг. Попробуйте позже.';\n  keyboard = active.length ? active.map(x => [{text:x.name, callback_data:'service:' + x.id}]) : null;\n} else if (ctx.kind === 'callback') {\n  const item = active.find(x => x.id === ctx.serviceId);\n  text = item\n    ? ('✅ Вы выбрали услугу: ' + item.name + '\\n\\nУслуга найдена по ID в базе данных. Можно вернуться к списку и выбрать другую.')\n    : '⚠️ Эта услуга больше недоступна. Меню могло измениться.';\n  keyboard = [[{text:'↩️ Вернуться к списку услуг', callback_data:'menu'}]];\n} else {\n  text = 'Отправьте /start, чтобы увидеть список услуг.';\n}\nreturn [{ json: {kind:ctx.kind,chatId:ctx.chatId,callbackId:ctx.callbackId,messageId:ctx.messageId,text,keyboard} }];"
      }
    },
    {
      "id": "send-telegram-message",
      "name": "Send or edit Telegram message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1220,
        260
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://api.telegram.org/bot' + $env.TELEGRAM_BOT_TOKEN + ($json.messageId ? '/editMessageText' : '/sendMessage') }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {chat_id:$json.chatId, ...($json.messageId ? {message_id:$json.messageId} : {}), text:$json.text, reply_markup: $json.keyboard ? {inline_keyboard:$json.keyboard} : undefined} }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      }
    },
    {
      "id": "was-callback-",
      "name": "Was callback?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1500,
        260
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "is-callback",
              "leftValue": "={{ $('Compose reply').first().json.kind }}",
              "rightValue": "callback",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      }
    },
    {
      "id": "acknowledge-callback",
      "name": "Acknowledge callback",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1740,
        195
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://api.telegram.org/bot' + $env.TELEGRAM_BOT_TOKEN + '/answerCallbackQuery' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { callback_query_id: $('Compose reply').first().json.callbackId, text: 'Выбор обработан' } }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      }
    }
  ],
  "connections": {
    "Telegram Trigger": {
      "main": [
        [
          {
